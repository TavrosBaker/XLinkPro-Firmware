  "he remote. Hold to press; release to stop.</div></section>\n<section id=\"cheats\" hidden><div class=\"cards cheat-grid\">\n<div class=\"card\"><div class=\"cheat-top\"><h2>Full Auto</h2><label class=\"switch\"><input id=\"rapidFire\" type=\"checkbox\"><span></span></label></div><div class=\"field\"><label>Speed <b id=\"rapidSpeedLabel\"></b></label><input id=\"rapidSpeed\" type=\"range\" min=\"1\" max=\"100\" step=\"1\" value=\"1\"></div><div class=\"sub\" id=\"rapidTiming\"></div></div>\n<div class=\"card\"><div class=\"cheat-top\"><h2>Auto Clicker</h2><label class=\"switch\"><input id=\"autoClick\" type=\"checkbox\"><span></span></label"
  "></div><div class=\"field\"><label for=\"clickButton\">Button</label><select id=\"clickButton\"><option value=\"11\">A</option><option value=\"12\">B</option><option value=\"13\">X</option><option value=\"14\">Y</option><option value=\"0\">D-pad Up</option><option value=\"1\">D-pad Down</option><option value=\"2\">D-pad Left</option><option value=\"3\">D-pad Right</option><option value=\"4\">Start</option><option value=\"5\">Back</option><option value=\"6\">Left Stick Click</option><option value=\"7\">Right Stick Click</option><option value=\"8\">LB</option><option value=\"9\">RB</option><option value=\"10\">Guide</option><optio"

  "div><h1 id=\"heading\">Settings</h1><p id=\"subtitle\"></p></div><span class=\"pill\" id=\"socket\">Connecting\u2026</span></div>\n<section id=\"settings\"><div class=\"cards\"><div class=\"card\"><h2>Connection</h2><div class=\"sub\">Controller input source</div><div class=\"metric\" id=\"source\">Waiting for controller</div></div><div class=\"card\"><h2>Bridge</h2><div class=\"sub\">ESP32 USB connection</div><div class=\"metric\" id=\"usb\">Checking\u2026</div></div><div class=\"card\"><h2>Network</h2><div class=\"sub\">ESP32 IP address</div><div class=\"metric\" id=\"ip\">\u2014</div></div></div>\n<div class=\"cards\"><div class=\"card\"><h2>Cont"

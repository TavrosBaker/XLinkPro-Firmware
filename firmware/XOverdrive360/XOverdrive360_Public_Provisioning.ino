// ESP32-S3: USB-OTG (TinyUSB), native USB port to Xbox 360.
// Uses built-in ESP-IDF HTTP server WebSocket support; no external WebSockets library.
// Browser Gamepad API requires a compatible browser and often HTTPS secure context.
// Wi-Fi credentials are provisioned over the UART connector and saved in NVS.
// No user-specific credentials are included in public firmware.
String wifiSSID;
String wifiPassword;
Preferences wifiPrefs;

WebServer http(80);
httpd_handle_t wsServer = nullptr;

// Browser bit layout remains unchanged from V7.
// WebSocket task ONLY writes input state. Arduino loop ONLY talks to USB.
// This prevents simultaneous TinyUSB calls from different FreeRTOS tasks.
portMUX_TYPE inputMux = portMUX_INITIALIZER_UNLOCKED;
struct InputFrame {
  uint16_t mask;
  float lt, rt, lx, ly, rx, ry;
  bool rapid;
  uint8_t speed;
  bool autoClick;
  uint8_t clickButton; // 0..14 digital, 15 LT, 16 RT
  uint32_t clickInterval;
  bool dropShot;
  uint16_t dropDuration;
  uint32_t receivedAt;
  int client;
};
InputFrame latest = {};
const uint32_t FAILSAFE_MS = 400;
const uint32_t USB_RETRY_MS = 2;
const uint32_t USB_KEEPALIVE_MS = 100;
const uint32_t CLICK_MIN_MS = 20, CLICK_MAX_MS = 120000;

// Convert browser button bits to XInput report bits (including guide).
uint32_t xinputMask(uint16_t b) {
  uint32_t result = b & 0x07ffU;
  result |= (uint32_t)(b & 0x7800U) << 1; // A/B/X/Y -> 0x1000..0x8000
  return result;
}
uint32_t rapidPressMs(uint8_t speed) { return 100U - ((uint32_t)(speed - 1) * 90U) / 99U; }
uint32_t rapidReleaseMs(uint8_t speed) { return 150U - ((uint32_t)(speed - 1) * 135U) / 99U; }


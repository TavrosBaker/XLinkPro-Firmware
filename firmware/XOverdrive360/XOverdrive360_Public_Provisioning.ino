float bounded(float v, float lo, float hi) { return isfinite(v) ? constrain(v,lo,hi) : 0.0f; }
// Single USB writer: one complete XInput report, retried when USB is busy.
// We deliberately never call X360Arduino from the HTTP server callback.
uint32_t lastUsbSuccess = 0;
uint32_t lastUsbAttempt = 0;
uint32_t previousButtons = 0xffffffffUL;
float previousAxes[6] = {NAN,NAN,NAN,NAN,NAN,NAN};
bool previousPulse = false;
bool previousRapidHeld = false;
uint32_t rapidCycleStart = 0;
uint32_t lastInputAge = 0;
bool previousClickEnabled = false;
uint8_t previousClickButton = 255;
uint32_t previousClickInterval = 0;
uint32_t clickCycleStart = 0;
bool previousDropTrigger = false;
uint32_t dropUntil = 0;
uint32_t failedUsbReports = 0;

void serviceController() {
  InputFrame in;
  portENTER_CRITICAL(&inputMux);
  in = latest;
  portEXIT_CRITICAL(&inputMux);
  const uint32_t now = millis();
  const bool alive = in.receivedAt != 0 && (uint32_t)(now - in.receivedAt) <= FAILSAFE_MS;
  if (!alive) {
    in.mask=0; in.lt=in.rt=in.lx=in.ly=in.rx=in.ry=0;
    in.rapid=false; in.autoClick=false; in.dropShot=false;
  }
  bool rapidHeld = in.rapid && in.rt >= 0.15f;
  if (rapidHeld && !previousRapidHeld) rapidCycleStart = now;
  previousRapidHeld = rapidHeld;
  bool pulse = false;
  float rightTrigger = in.rt;
  if (rapidHeld) {
    const uint32_t press = rapidPressMs(in.speed);
    const uint32_t cycle = press + rapidReleaseMs(in.speed);
    pulse = ((uint32_t)(now - rapidCycleStart) % cycle) < press;
    rightTrigger = pulse ? in.rt : 0.0f;
  }
  // Independent, non-blocking auto-click timer. Never remove a physical hold.
  if (in.autoClick && (!previousClickEnabled || in.clickButton != previousClickButton || in.clickInterval != previousClickInterval)) clickCycleStart=now;
  previousClickEnabled=in.autoClick;
  previousClickButton=in.clickButton;
  previousClickInterval=in.clickInterval;
  bool clickPulse=false;
  if(in.autoClick) {
    const uint32_t period=constrain(in.clickInterval,CLICK_MIN_MS,CLICK_MAX_MS);
    const uint32_t hold=min((uint32_t)30,max((uint32_t)5,period/2));
    clickPulse=((uint32_t)(now-clickCycleStart)%period)<hold;
  }
  // Auto drop-shot triggers once when RT crosses the threshold.
  const bool dropTrigger=in.dropShot && in.rt>=0.15f;
  if(dropTrigger && !previousDropTrigger) dropUntil=now+constrain((uint32_t)in.dropDuration,500U,2000U);
  if(!in.dropShot || !alive) dropUntil=0;
  previousDropTrigger=dropTrigger;
  uint16_t mask=in.mask;
  if(in.dropShot && alive && (int32_t)(dropUntil-now)>0) mask|=(1U<<12); // B = default crouch
  float leftTrigger=in.lt;
  if(clickPulse){
    if(in.clickButton<=14)mask|=(1U<<in.clickButton);
    else if(in.clickButton==15)leftTrigger=1.0f;
    else if(in.clickButton==16)rightTrigger=1.0f;
  }
  const uint32_t buttons = xinputMask(mask);
  const float axes[6] = {leftTrigger,rightTrigger,in.lx,in.ly,in.rx,in.ry};
  bool changed = buttons != previousButtons;
  for(int i=0;i<6;i++) if(!isfinite(previousAxes[i]) || fabsf(axes[i]-previousAxes[i])>0.002f) changed=true;
  // Only send on changes or occasional keepalive. No redundant per-button reports.
  if (!changed && (uint32_t)(now-lastUsbSuccess)<USB_KEEPALIVE_MS) return;
  if ((uint32_t)(now-lastUsbAttempt)<USB_RETRY_MS) return;
  lastUsbAttempt=now;
  if (X360Arduino.setState(buttons, axes[2],axes[3],axes[4],axes[5],axes[0],axes[1])) {
    previousButtons=buttons;
    memcpy(previousAxes,axes,sizeof(axes));
    lastUsbSuccess=now;
  } else {
    failedUsbReports++;
  }
}
// Native ESP-IDF WebSocket endpoint on port 81.
// Connection ownership is keyed by the HTTP server socket descriptor.
esp_err_t onNativeWebSocket(httpd_req_t* req) {
  if (req->method == HTTP_GET) return ESP_OK; // WebSocket handshake

  httpd_ws_frame_t frame = {};
  frame.type = HTTPD_WS_TYPE_TEXT;
  esp_err_t err = httpd_ws_recv_frame(req, &frame, 0);
  if (err != ESP_OK) return err;
  if (frame.len == 0 || frame.len > 240) return ESP_OK;

  char data[241];
  frame.payload = (uint8_t*)data;
  err = httpd_ws_recv_frame(req, &frame, 240);
  if (err != ESP_OK) return err;
  if (frame.type != HTTPD_WS_TYPE_TEXT) return ESP_OK;
  data[frame.len] = '\0';

  const int client = httpd_req_to_sockfd(req);
  int seq=0,mask=0,rapidFlag=0,speedValue=1,clickFlag=0,clickButton=11,clickInterval=20,dropFlag=0,dropDuration=1000;
  float lt=0,rt=0,lx=0,ly=0,rx=0,ry=0;
  if (sscanf(data,"I,%d,%d,%f,%f,%f,%f,%f,%f,%d,%d,%d,%d,%d,%d,%d",&seq,&mask,&lt,&rt,&lx,&ly,&rx,&ry,&rapidFlag,&speedValue,&clickFlag,&clickButton,&clickInterval,&dropFlag,&dropDuration) != 15) return ESP_OK;
  if (mask < 0 || mask > 32767) return ESP_OK;
  const uint32_t now=millis();
  portENTER_CRITICAL(&inputMux);
  const bool mayTakeOver = latest.client == 0 || latest.client == client ||
                           (uint32_t)(now - latest.receivedAt) > FAILSAFE_MS;
  if (mayTakeOver) {
    latest.mask=(uint16_t)mask;
    latest.lt=bounded(lt,0,1); latest.rt=bounded(rt,0,1);
    latest.lx=bounded(lx,-1,1); latest.ly=bounded(ly,-1,1);
    latest.rx=bounded(rx,-1,1); latest.ry=bounded(ry,-1,1);
    latest.rapid=(rapidFlag==1);
    latest.speed=(uint8_t)constrain(speedValue,1,100);
    latest.autoClick=clickFlag==1;
    latest.clickButton=(uint8_t)constrain(clickButton,0,16);
    latest.clickInterval=(uint32_t)constrain(clickInterval,20,120000);
    latest.dropShot=dropFlag==1;
    latest.dropDuration=(uint16_t)constrain(dropDuration,500,2000);
    latest.receivedAt=now;
    latest.client=client;
  }
  portEXIT_CRITICAL(&inputMux);

  // Return status on the same socket; avoids cross-thread broadcast handling.
  static uint32_t lastStatus = 0;
  if (millis() - lastStatus >= 1500) {
    lastStatus = millis();
    String msg = String("S,") + (X360Arduino.ready()?"1,":"0,") + WiFi.localIP().toString();
    httpd_ws_frame_t reply = {};
    reply.type = HTTPD_WS_TYPE_TEXT;
    reply.payload = (uint8_t*)msg.c_str();
    reply.len = msg.length();
    httpd_ws_send_frame(req, &reply);
  }
  return ESP_OK;
}

void startNativeWebSocket() {
  httpd_config_t config = HTTPD_DEFAULT_CONFIG();
  config.server_port = 81;
  config.ctrl_port = 32769;
  config.max_open_sockets = 5;
  config.lru_purge_enable = true;
  if (httpd_start(&wsServer, &config) != ESP_OK) {
    Serial.println("ERROR: Native WebSocket server failed to start");
    return;
  }
  httpd_uri_t endpoint = {};
  endpoint.uri = "/";
  endpoint.method = HTTP_GET;
  endpoint.handler = onNativeWebSocket;
  endpoint.is_websocket = true;
  if (httpd_register_uri_handler(wsServer, &endpoint) != ESP_OK)
    Serial.println("ERROR: Native WebSocket route registration failed");
  else
    Serial.println("Native WebSocket server listening on port 81");
}


// XLinkPro UART provisioning protocol, 9600 baud, line-delimited ASCII.
// XLINK HELLO
// XLINK INFO
// XLINK WIFI STATUS
// XLINK WIFI SET <hex-encoded UTF-8 SSID> <hex-encoded UTF-8 password or ->
// XLINK WIFI CLEAR
// XLINK REBOOT
// Credentials are never printed in responses. Use only on a trusted physical UART.
static char xlinkLine[240];
static size_t xlinkUsed = 0;
static bool xlinkOverflow = false;
static bool wifiStarted = false;
static bool wifiReported = false;
static uint32_t wifiAttemptAt = 0;
static uint32_t wifiLastCheck = 0;
static uint32_t xlinkRebootAt = 0;

static bool xlinkDecodeHex(const String &hex, String &out, size_t maxBytes) {
  out = "";
  if (hex == "-") return true;
  if ((hex.length() & 1) || hex.length() > maxBytes * 2) return false;
  for (size_t i = 0; i < hex.length(); i += 2) {
    auto digit = [](char c) -> int {
      if (c >= '0' && c <= '9') return c - '0';
      if (c >= 'a' && c <= 'f') return c - 'a' + 10;
      if (c >= 'A' && c <= 'F') return c - 'A' + 10;
      return -1;
    };
    int a = digit(hex[i]), b = digit(hex[i + 1]);
    if (a < 0 || b < 0 || (a == 0 && b == 0)) return false;
    out += char((a << 4) | b);
  }
  return true;
}

static void xlinkStartWiFi() {
  if (!wifiSSID.length()) { wifiStarted = false; return; }
  WiFi.disconnect(false, false);
  WiFi.begin(wifiSSID.c_str(), wifiPassword.c_str());
  wifiStarted = true;
  wifiReported = false;
  wifiAttemptAt = millis();
}

static void xlinkLoadWiFi() {
  if (!wifiPrefs.begin("xlinkwifi", true)) return;
  wifiSSID = wifiPrefs.getString("ssid", "");
  wifiPassword = wifiPrefs.getString("password", "");
  wifiPrefs.end();
}

static void xlinkCommand(const String &line) {
  if (line == "XLINK HELLO") {
    Serial.println("XLINK OK XLinkPro 1.0.0 XOverdrive360 1.1.0-beta PROTO=1");
  } else if (line == "XLINK INFO") {
    Serial.printf("XLINK INFO chip=%s flash=%lu psram=%lu heap=%lu uptime=%lu version=1.1.0-beta\n",
      ESP.getChipModel(), (unsigned long)ESP.getFlashChipSize(),
      (unsigned long)ESP.getPsramSize(), (unsigned long)ESP.getFreeHeap(),
      (unsigned long)(millis() / 1000));
  } else if (line == "XLINK WIFI STATUS") {
    Serial.printf("XLINK WIFI configured=%d connected=%d ip=%s\n", wifiSSID.length() ? 1 : 0,
      WiFi.status() == WL_CONNECTED ? 1 : 0,
      WiFi.status() == WL_CONNECTED ? WiFi.localIP().toString().c_str() : "0.0.0.0");
  } else if (line.startsWith("XLINK WIFI SET ")) {
    String args = line.substring(15);
    int split = args.indexOf(' ');
    if (split < 0) { Serial.println("XLINK ERR FORMAT"); return; }
    String ssid, pass;
    if (!xlinkDecodeHex(args.substring(0, split), ssid, 32) || ssid.length() == 0 ||
        !xlinkDecodeHex(args.substring(split + 1), pass, 63) ||
        (pass.length() > 0 && pass.length() < 8)) {
      Serial.println("XLINK ERR INVALID_WIFI"); return;
    }
    if (!wifiPrefs.begin("xlinkwifi", false)) { Serial.println("XLINK ERR NVS_OPEN"); return; }
    bool ok = wifiPrefs.putString("ssid", ssid) == ssid.length();
    // Empty password is allowed for open Wi-Fi networks.
    if (ok) ok = wifiPrefs.putString("password", pass) == pass.length() || pass.isEmpty();
    wifiPrefs.end();
    if (!ok) { Serial.println("XLINK ERR NVS_WRITE"); return; }
    wifiSSID = ssid;
    wifiPassword = pass;
    Serial.println("XLINK OK WIFI_SAVED");
    xlinkStartWiFi();
  } else if (line == "XLINK WIFI CLEAR") {
    if (!wifiPrefs.begin("xlinkwifi", false)) { Serial.println("XLINK ERR NVS_OPEN"); return; }
    bool ok = wifiPrefs.clear();
    wifiPrefs.end();
    if (!ok) { Serial.println("XLINK ERR NVS_CLEAR"); return; }
    wifiSSID = ""; wifiPassword = "";
    WiFi.disconnect(false, false);
    wifiStarted = false;
    Serial.println("XLINK OK WIFI_CLEARED");
  } else if (line == "XLINK REBOOT") {
    Serial.println("XLINK OK REBOOTING");
    xlinkRebootAt = millis() + 150;
  } else {
    Serial.println("XLINK ERR UNKNOWN_COMMAND");
  }
}

static void xlinkServiceSerial() {
  // At most 64 bytes per loop iteration to keep controller servicing responsive.
  for (int n = 0; n < 64 && Serial.available() > 0; ++n) {
    char c = char(Serial.read());
    if (c == '\r') continue;
    if (c == '\n') {
      if (xlinkOverflow) Serial.println("XLINK ERR LINE_TOO_LONG");
      else if (xlinkUsed) { xlinkLine[xlinkUsed] = 0; xlinkCommand(String(xlinkLine)); }
      xlinkUsed = 0;
      xlinkOverflow = false;
    } else if (!xlinkOverflow) {
      if (xlinkUsed + 1 >= sizeof(xlinkLine)) xlinkOverflow = true;
      else xlinkLine[xlinkUsed++] = c;
    }
  }
}

static void xlinkServiceWiFi() {
  uint32_t now = millis();
  if (now - wifiLastCheck < 1000) return;
  wifiLastCheck = now;
  if (WiFi.status() == WL_CONNECTED) {
    if (!wifiReported) {
      Serial.print("XLINK WIFI CONNECTED ip="); Serial.println(WiFi.localIP());
      wifiReported = true;
    }
  } else if (wifiSSID.length() && (!wifiStarted || now - wifiAttemptAt >= 20000)) {
    xlinkStartWiFi();
  }
}

void setup(){
  Serial.begin(9600);delay(400);
  Serial.println("XLinkPro 1.0.0 Public Release | XOverdrive360 1.1.0 Beta | Tavros Baker");
  if(!X360Arduino.begin())Serial.println("WARNING: X360Arduino USB startup failed");
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false); // Minimise Wi-Fi power-save latency
  xlinkLoadWiFi();
  if (wifiSSID.length()) { Serial.println("Wi-Fi configured; connecting asynchronously."); xlinkStartWiFi(); }
  else Serial.println("Wi-Fi not configured. Use UART: XLINK WIFI SET <ssid_hex> <password_hex>");
  http.on("/",HTTP_GET,[]{http.send_P(200,"text/html; charset=utf-8",PAGE);});
  http.on("/stats",HTTP_GET,[]{
    char body[350];
    const bool online=WiFi.status()==WL_CONNECTED;
    snprintf(body,sizeof(body),"{\"version\":13,\"temp\":%.1f,\"heap\":%lu,\"minHeap\":%lu,\"rssi\":%d,\"uptime\":%lu,\"cpu\":%lu,\"channel\":%d,\"wifi\":%s}",
      (double)temperatureRead(),(unsigned long)ESP.getFreeHeap(),(unsigned long)ESP.getMinFreeHeap(),
      online?WiFi.RSSI():0,(unsigned long)(millis()/1000),(unsigned long)ESP.getCpuFreqMHz(),online?WiFi.channel():0,online?"true":"false");
    http.sendHeader("Cache-Control","no-store");http.send(200,"application/json",body);
  });
  http.onNotFound([]{http.send(404,"text/plain","Not found");});
  http.begin();startNativeWebSocket();
}
void loop(){
  http.handleClient();
  serviceController();
  xlinkServiceSerial();
  xlinkServiceWiFi();
  if (xlinkRebootAt && (int32_t)(millis() - xlinkRebootAt) >= 0) ESP.restart();
  delay(1);
}
